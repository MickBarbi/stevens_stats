# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Prisma database connection string (SQL Server).
# Example (local SQL Server Express with integrated security):
#   DATABASE_URL="sqlserver://HOST\\INSTANCE;database=YOUR_DB;integrated security=true;trustServerCertificate=true;"
# Example (hosted SQL Server with credentials):
#   DATABASE_URL="sqlserver://YOUR_HOST:1433;database=YOUR_DB;user=YOUR_USER;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"
DATABASE_URL="sqlserver://HOST:1433;database=YOUR_DB;user=YOUR_USER;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"

# Cloudinary cloud name used to build public image URLs (exposed to the browser).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API credentials — only used by scraper/photos_upload.py to push
# roster headshots. Not needed to run the site. (Dashboard → API Keys)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
