generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// One row per rostered athlete. `athlete_id` is the athlete's TFRRS id.
/// `active` replaces the old `year == -1` sentinel for "hide from the site".
model Athletes {
  athlete_id      Int            @id(map: "PK_Athletes")
  first_name      String         @db.VarChar(50)
  last_name       String         @db.VarChar(50)
  year            Int
  graduation_year Int?
  sex             String?        @db.Char(1)
  active          Boolean        @default(true)
  nickname        String?        @db.VarChar(50)
  bio             String?        @db.NVarChar(Max)
  image_path      String?        @db.VarChar(50)
  Awards          Awards[]
  Performances    Performances[]
}

model Awards {
  athlete_id Int
  award      String   @db.NVarChar(100)
  Athletes   Athletes @relation(fields: [athlete_id], references: [athlete_id], onUpdate: NoAction, map: "FK_Awards_Athletes")

  @@id([athlete_id, award], map: "PK_Awards")
}

model Blog_Posts {
  post_id    Int      @id(map: "PK_Blog_Posts") @default(autoincrement())
  title      String   @db.NVarChar(50)
  body       String   @db.NVarChar(Max)
  created_on DateTime @db.Date
  author     String   @db.NVarChar(50)
  subheading String   @db.NVarChar(Max)
}

model Events {
  event_id             Int                    @id(map: "PK_Events")
  event_name           String                 @db.VarChar(50)
  event_season         String                 @db.VarChar(7) // "Indoor" | "Outdoor" | "Both"
  Performances         Performances[]
  Qualifying_Standards Qualifying_Standards[]
}

/// The single source of truth: one row per individual result an athlete has
/// ever recorded. Everything the site shows as a "best" is just a row here
/// with the matching flag set - the flags are recomputed from scratch by
/// scraper/load.py on every run, so this table is the only thing that has to
/// be loaded.
///
///   is_personal_best   - best mark for this athlete + event, either season
///   is_collegiate_best - best mark that counts as collegiate (today: same as
///                        personal_best; kept separate for future non-college marks)
///   is_overall_best    - best mark for this athlete + event + season
///   is_season_best     - best mark for this athlete + event + season since the
///                        current season's start date
///
/// Indoor vs. outdoor is read from this row's own `season`, so those four
/// flags cover all of the old Bests table's columns.
model Performances {
  performance_id     Int      @id(map: "PK_Performances") @default(autoincrement())
  athlete_id         Int
  event_id           Int
  mark               Decimal  @db.Decimal(10, 2)
  season             String   @db.NChar(1) // 'i' | 'o'
  date               DateTime @db.Date
  result_link        String?  @db.NVarChar(Max)
  ranking            Int? // finishing place at that meet, when TFRRS lists one
  is_personal_best   Boolean  @default(false)
  is_collegiate_best Boolean  @default(false)
  is_overall_best    Boolean  @default(false)
  is_season_best     Boolean  @default(false)
  Athletes           Athletes @relation(fields: [athlete_id], references: [athlete_id], onUpdate: NoAction, map: "FK_Performances_Athletes")
  Events             Events   @relation(fields: [event_id], references: [event_id], onUpdate: NoAction, map: "FK_Performances_Events")

  @@unique([athlete_id, event_id, date, mark, season], map: "UQ_Performances_natural")
  @@index([athlete_id], map: "IX_Performances_athlete")
  @@index([event_id], map: "IX_Performances_event")
}

model Qualifying_Standards {
  event_id                   Int
  gender                     String   @db.VarChar(10)
  season                     String   @db.VarChar(10)
  mac_qualifying_standard    Decimal? @db.Decimal(10, 2)
  aartfc_qualifying_standard Decimal? @db.Decimal(10, 2)
  Events                     Events   @relation(fields: [event_id], references: [event_id], onUpdate: NoAction, map: "FK_Qualifying_Standards_Events")

  @@id([event_id, gender, season], map: "PK_Qualifying_Standards")
}
